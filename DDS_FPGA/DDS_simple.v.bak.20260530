module DDS_simple(
    input         clk,        // 系统时钟 50MHz
    input         rst_n,      // 低电平复位
    input         uart_rx,    // MCU TX 输入
    input         switch,     // 原有拨码开关：1=测试，0=控制
    input         sw_ask,     // 10 = ASK 模式
    input         sw_psk,     // 01 = PSK 模式
	 input         sw_liss,    // 100 = 李萨如图测试模式 (DAC 1k, PWM 2k)
	 input         sw_change_a,// 纯输，默认14bit，打开后sin变成12bit
    // ----------------------
    output        led,        
    output [13:0] sine_out,   // 14 位 DAC 输出
    output        baseband_out, // 二进制基带序列输出
    output [7:0]  seg,        // 数码管段选
    output [5:0]  sel,        // 6 位位选
    output        out_dacclk, 
    output        locked,      
	 output        pwm_out
);

// ============================================================
// 1. 信号定义
// ============================================================
wire [31:0] uart_data;
wire        uart_data_valid;
wire [2:0]  uart_mode;
wire        uart_mode_valid;
wire [1:0]  uart_data_idx;
wire [2:0]  uart_dot_cnt;

reg [2:0]   work_mode;
reg [31:0]  sine_freq;
reg [31:0]  am_fc;
reg [7:0]   am_ma;
reg [31:0]  fm_fc;
reg [31:0]  fm_dev;

reg  [31:0] phase;
reg  [31:0] mod_phase;
wire [13:0] rom_data; 
wire [13:0] mod_data; 

wire [31:0] freq_ctrl_word;
reg  [31:0] freq_target;
reg  [31:0] display_freq;

// --- 新增：李萨如图模式信号 ---
reg [31:0] phase_1k;
reg [31:0] phase_2k;
wire [13:0] sine_1k_data;
wire [13:0] sine_2k_data;
// 50MHz时钟下：1kHz FTW = 85899, 2kHz FTW = 171798
parameter FTW_1K = 32'd85899;
parameter FTW_2K = 32'd171798;

// ASK/PSK 专用信号
reg [12:0] bb_cnt;
reg [7:0]  bb_shift_reg;
reg        baseband_reg;
reg [31:0] digital_mod_phase;
wire [13:0] psk_data;
wire [13:0] carrier_100k;

// AM 调制中间信号
wire signed [14:0] carrier_signed;
wire signed [14:0] mod_signed;
wire signed [23:0] mod_depth_long;
wire signed [14:0] mod_depth;
wire signed [15:0] envelope;       
wire signed [30:0] am_mult;
wire signed [15:0] am_scaled;      
wire signed [15:0] am_final_signed;
wire [13:0] am_out;

// 正弦波幅度调整：增益 5/8，峰峰值约 10240 LSB (~6V)
wire signed [14:0] rom_signed = {1'b0, rom_data} - 15'sd8192;
wire signed [31:0] sine_gain_tmp = rom_signed * 32'sd15;
wire signed [14:0] sine_gain_signed = sine_gain_tmp / 32'sd32;
wire [13:0]        sine_gain = sine_gain_signed + 15'sd8192;

// ============================================================
// 2. 二进制基带序列产生 (10kbps)
// ============================================================
always @(posedge clk or negedge rst_n) begin
    if(!rst_n) begin
        bb_cnt <= 13'd0;
        bb_shift_reg <= 8'b10110010; 
        baseband_reg <= 1'b0;
    end else begin
        if(bb_cnt >= 13'd4999) begin // 50MHz / 5000 = 10kHz
            bb_cnt <= 13'd0;
            bb_shift_reg <= {bb_shift_reg[6:0], bb_shift_reg[7]};
            baseband_reg <= bb_shift_reg[7];
        end else begin
            bb_cnt <= bb_cnt + 1'b1;
        end
    end
end
assign baseband_out = (sw_ask ^ sw_psk) ? baseband_reg : 1'b0;

// ============================================================
// 3. 100kHz 固定载波与调制逻辑
// ============================================================
always @(posedge clk or negedge rst_n) begin
    if(!rst_n) digital_mod_phase <= 0;
    else digital_mod_phase <= digital_mod_phase + 32'd8589935; // 100kHz
end

// PSK 逻辑
wire [7:0] psk_addr = baseband_reg ? digital_mod_phase[31:24] : (digital_mod_phase[31:24] + 8'd128);
sine_14bit_256 u_rom_psk (.address(psk_addr), .clock(clk), .q(psk_data));

// ASK 逻辑
sine_14bit_256 u_rom_ask (.address(digital_mod_phase[31:24]), .clock(clk), .q(carrier_100k));
wire [13:0] ask_data = baseband_reg ? carrier_100k : 14'd8192;

// ============================================================
// 4. 原有模块实例化
// ============================================================
dds_freq_ctrlword u_freq_ctrlword(
    .clk(clk), .rst_n(rst_n), .freq_target(freq_target), .freq_ctrl_word(freq_ctrl_word)
);

MCU_uart u_mcu_uart(
    .clk(clk), .rst_n(rst_n), .uart_rx(uart_rx), .data_out(uart_data),
    .data_valid(uart_data_valid), .data_idx(uart_data_idx),
    .dot_cnt(uart_dot_cnt),
    .mode_sel(uart_mode), .mode_valid(uart_mode_valid)
);

wire [31:0] display_ma = (work_mode == 3'd3) ? (fm_dev / 32'd1000) : {24'd0, am_ma};

seg_display u_seg_display(
    .clk(clk), .rst_n(rst_n), .en(1'b1), .freq(display_freq),
    .ma(display_ma), .sel(sel), .seg(seg)
);

// 李萨如图波形 ROM 查找
sine_14bit_256 u_rom_1k (.address(phase_1k[31:24]), .clock(clk), .q(sine_1k_data));
sine_14bit_256 u_rom_2k (.address(phase_2k[31:24]), .clock(clk), .q(sine_2k_data));

// PWM 实例化
// 仅当 sw_liss 打开且其他两个关闭时，PWM输出2kHz，否则输出中性点或0
wire [13:0] pwm_input_mux = (sw_liss && !sw_ask && !sw_psk) ? sine_2k_data : 14'd0;
sintopwm u_pwm_inst (
    .clk(clk),
    .sine_val(pwm_input_mux),
    .pwm(pwm_out)
);


 //先定义两个中间信号
wire [11:0] rom_data_12bit;
wire [13:0] rom_data_14bit;

// 模块例化必须写在 if 外面！！！
sine_12bit_256 u_rom_carrier_12 (
    .address (phase[31:24]),
    .clock(clk),
    .q(rom_data_12bit)
);

sine_14bit_256 u_rom_carrier_14 (
    .address (phase[31:24]),
    .clock(clk),
    .q(rom_data_14bit)
);

// 然后用 assign 选择输出
assign rom_data = sw_change_a ? (14'd8192 - 14'd2048 + {2'b00, rom_data_12bit}) : rom_data_14bit;

//sine_12bit_256 u_rom_carrier (
//    .address (phase[31:24]),
//    .clock(clk),
//    .q(rom_data)
//);

sine_14bit_256 u_rom_mod (
    .address (mod_phase[31:24]), .clock(clk), .q(mod_data)
);

// ============================================================
// 5. DDS 频率控制与参数管理
// ============================================================
always @(posedge clk or negedge rst_n) begin
    if(!rst_n) begin
        work_mode <= 3'd1; sine_freq <= 32'd1000;
        am_fc <= 32'd1_000_000; am_ma <= 8'd10;
        fm_fc <= 32'd100_000;   fm_dev <= 32'd5000;
    end else begin
        if(uart_mode_valid) work_mode <= uart_mode;
        if(uart_data_valid) begin
            case(work_mode)
                3'd1: sine_freq <= uart_data;
                3'd2: begin 
                    if(uart_data_idx == 2'd0)      am_fc <= uart_data;
                    else if(uart_data_idx == 2'd1) am_ma <= uart_data[7:0];
                end
                3'd3: begin
                    if(uart_data_idx == 2'd0) begin
                        fm_fc <= uart_data;
                    end else if(uart_data_idx == 2'd1) begin
                        case(uart_dot_cnt)
                            3'd0: fm_dev <= uart_data;           // 整数：直接当 Hz 用，兼容单片机
                            3'd1: fm_dev <= uart_data * 32'd100; // 1位小数：默认单位 kHz -> Hz
                            3'd2: fm_dev <= uart_data * 32'd10;
                            3'd3: fm_dev <= uart_data * 32'd1;
                            default: fm_dev <= uart_data;
                        endcase
                    end
                end
            endcase
        end
    end
end

always @(posedge clk or negedge rst_n) begin
    if(!rst_n) mod_phase <= 0;
    else mod_phase <= mod_phase + 32'd86_000;
end

// 李萨如图相位累加器：1kHz 和 2kHz
always @(posedge clk or negedge rst_n) begin
    if(!rst_n) begin
        phase_1k <= 0;
        phase_2k <= 0;
    end else begin
        phase_1k <= phase_1k + FTW_1K;
        phase_2k <= phase_2k + FTW_2K;
    end
end

wire signed [14:0] fm_mod_signed = {1'b0, mod_data} - 15'sd8192;
wire signed [46:0] fm_dev_mult   = $signed({1'b0, fm_dev}) * fm_mod_signed;
wire signed [31:0] fm_deviation  = fm_dev_mult >>> 13;
wire [31:0] fm_ctrl_word = ($signed(fm_fc) + fm_deviation) * 32'sd86;

reg [31:0] phase_step;
always @(*) begin
    if(!switch && work_mode == 3'd3) phase_step = fm_ctrl_word;
    else phase_step = freq_ctrl_word;
end

always @(posedge clk or negedge rst_n) begin
    if(!rst_n) phase <= 0;
    else phase <= phase + phase_step;
end

// ============================================================
// 6. AM 调制算法逻辑（优化版）
// ============================================================
// 标准 AM：s(t) = [1 + m * x_m(t)] * x_c(t)
// 定点化说明：
//   carrier_signed = rom_data - 8192  (范围 [-8192, 8191])
//   mod_signed     = mod_data - 8192  (范围 [-8192, 8191])
//   depth          = mod_signed * ma / 100  (当 ma=100 时约 ±8192)
//   envelope       = 8192 + depth     (1.0 用 8192 表示)
//   output_ac      = carrier_signed * envelope / 8192
//   output         = output_ac + 8192 (转回单极性 DAC)
// ------------------------------------------------------------
// 优化点：
// 1. m=0 时 envelope=8192，output_ac=carrier_signed，输出严格等于 rom_data
// 2. 使用 /8192 (>>>13) 而非 /16384，恢复满幅载波，避免无调制时衰减 6dB
// 3. 偏置固定为 8192，消除原有偏置误差
// ------------------------------------------------------------
assign carrier_signed = $signed({1'b0, rom_data}) - 15'sd8192;
assign mod_signed     = $signed({1'b0, mod_data}) - 15'sd8192;

// 调制深度分量，带舍入
assign mod_depth_long = mod_signed * $signed({1'b0, am_ma});
assign mod_depth      = (mod_depth_long + 24'sd50) / 100;

// 包络：1.0 + depth
// 限制最小 envelope = 128，防止 12bit 模式下载波分辨率不足时谷底完全消幅成死区
wire signed [15:0] envelope_raw = 16'sd8192 + mod_depth;
assign envelope = (envelope_raw < 16'sd128) ? 16'sd128 : envelope_raw;

// 核心乘法
assign am_mult        = carrier_signed * envelope;

// 除以 8192(2^13)，加 4096 做四舍五入
// 当 m=0 时，此处严格还原 carrier_signed，不再额外衰减
assign am_scaled      = (am_mult + 31'sd4096) >>> 13;

// 加 8192 直流偏置
assign am_final_signed = am_scaled + 16'sd8192;

assign am_out = (am_final_signed > 16'sd16383) ? 14'd16383 :
                (am_final_signed < 16'sd0)     ? 14'd0     :
                 am_final_signed[13:0];

// ============================================================
// 7. 最终输出切换 (核心逻辑：全开或全关回退原功能)
// ============================================================
reg [13:0] dac_comb;

always @(*) begin
    if (sw_ask == 1'b1 && sw_psk == 1'b0) begin
        // --- 仅开开关1：ASK ---
        dac_comb = ask_data;
        freq_target = 32'd100_000;
        display_freq = 32'd100_000;
    end 
    else if (sw_ask == 1'b0 && sw_psk == 1'b1) begin
        // --- 仅开开关2：PSK ---
        dac_comb = psk_data;
        freq_target = 32'd100_000;
        display_freq = 32'd100_000;
    end 
	     //李萨如图，开关3
	 else if(sw_liss == 1'b1 && sw_ask == 1'b0 && sw_psk == 1'b0) begin
        dac_comb = sine_1k_data;      // DAC 输出 1kHz
        freq_target = 32'd1000;       // 方便数码管显示
        display_freq = 32'd1000;
    end
    else begin
        // 其他：执行原有功能
        if(switch) begin
            dac_comb = sine_gain; freq_target = 32'd1000; display_freq = 32'd1000;
        end else begin
            case(work_mode)
                3'd1: begin dac_comb = sine_gain; freq_target = sine_freq; display_freq = sine_freq; end
                3'd2: begin dac_comb = am_out;    freq_target = am_fc;     display_freq = am_fc;     end
                3'd3: begin dac_comb = rom_data;  freq_target = fm_fc;     display_freq = fm_fc;     end
                default: begin dac_comb = sine_gain; freq_target = sine_freq; display_freq = sine_freq; end
            endcase
        end
    end
end

assign sine_out = dac_comb;
assign led = 1'b1;

dac904_pll u_pll (.areset(1'b0), .inclk0(clk), .c0(out_dacclk), .locked(locked));

endmodule 





