module dds_freq_ctrlword(
    input         clk,          // 系统时钟 50MHz
    input         rst_n,        // 低电平复位
    input  [8:0]  freq_target,  
    output [31:0] freq_ctrl_word
);

// ===================== 核心参数 =====================
parameter F_CLK       = 32'd50_000_000;  // 系统时钟 = 50MHz
parameter PHASE_W     = 32;             // 相位累加器位宽 32位
// ====================================================

reg [31:0] freq_ctrl_reg;
always @(posedge clk or negedge rst_n) begin
    if(!rst_n)
        freq_ctrl_reg <= 32'd0;
    else
        freq_ctrl_reg <= (freq_target * (2**PHASE_W)) / F_CLK;
end
assign freq_ctrl_word = freq_ctrl_reg;
endmodule 