module seg_display(
    input             clk,        // 50MHz
    input             rst_n,
    input      [31:0] freq,       // 输入频率值 (100 ~ 10,000,000)
    output reg [3:0]  sel,        // 位选 (低电平有效或高电平有效，取决于你的硬件)
    output reg [7:0]  seg         // 段选 (a-g + dp)
);

// --- 1. 频率转科学计数法逻辑 ---
reg [3:0] x_val, y_val, z_val;

always @(*) begin
    if (freq >= 10_000_000) begin      // 10MHz = 1.0 * 10^7
        x_val = 4'd1; y_val = 4'd0; z_val = 4'd7;
    end else if (freq >= 1_000_000) begin // 1MHz = X.Y * 10^6
        x_val = freq / 1_000_000;
        y_val = (freq / 100_000) % 10;
        z_val = 4'd6;
    end else if (freq >= 100_000) begin   // 100kHz = X.Y * 10^5
        x_val = freq / 100_000;
        y_val = (freq / 10_000) % 10;
        z_val = 4'd5;
    end else if (freq >= 10_000) begin    // 10kHz = X.Y * 10^4
        x_val = freq / 10_000;
        y_val = (freq / 1_000) % 10;
        z_val = 4'd4;
    end else if (freq >= 1_000) begin     // 1kHz = X.Y * 10^3
        x_val = freq / 1_000;
        y_val = (freq / 100) % 10;
        z_val = 4'd3;
    end else begin                        // 100Hz = X.Y * 10^2
        x_val = freq / 100;
        y_val = (freq / 10) % 10;
        z_val = 4'd2;
    end
end

// --- 2. 扫描定时器 (1ms) ---
reg [15:0] scan_cnt;
reg [1:0]  scan_sel;

always @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin
        scan_cnt <= 0;
        scan_sel <= 0;
    end else if (scan_cnt >= 16'd49_999) begin // 1ms @ 50MHz
        scan_cnt <= 0;
        scan_sel <= scan_sel + 1'b1;
    end else begin
        scan_cnt <= scan_cnt + 1'b1;
    end
end

// --- 3. 段码译码表 (共阴极示例, 1亮0灭) ---
// 如果是共阳极，请将结果取反 ~code
function [7:0] decode(input [3:0] num);
    case(num)
        4'd0: decode = 8'h3F; // "0"
        4'd1: decode = 8'h06; // "1"
        4'd2: decode = 8'h5B; // "2"
        4'd3: decode = 8'h4F; // "3"
        4'd4: decode = 8'h66; // "4"
        4'd5: decode = 8'h6D; // "5"
        4'd6: decode = 8'h7D; // "6"
        4'd7: decode = 8'h07; // "7"
        4'd8: decode = 8'h7F; // "8"
        4'd9: decode = 8'h6F; // "9"
        default: decode = 8'h00; // 空白
    endcase
endfunction

// --- 4. 动态扫描显示逻辑 ---
always @(posedge clk) begin
    case(scan_sel)
        2'd0: begin
            sel <= 4'b0111; // 选通第1位 (X)
            seg <= decode(x_val) | 8'h80; // 显示数字并点亮小数点(DP)
        end
        2'd1: begin
            sel <= 4'b1011; // 选通第2位 (Y)
            seg <= decode(y_val);
        end
        2'd2: begin
            sel <= 4'b1101; // 选通第3位 (空)
            seg <= 8'h00;   
        end
        2'd3: begin
            sel <= 4'b1110; // 选通第4位 (Z)
            seg <= decode(z_val);
        end
    endcase
end

endmodule