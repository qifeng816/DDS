// 模块名称：MCU_uart
// 功能：UART接收单片机按键(ASCII) → 识别数字 → 数码管显示
// 时钟：50MHz | 波特率：115200 | 数码管：静态显示1位
module MCU_uart(
    input         clk,        // FPGA系统时钟 50MHz
    input         rst_n,      // 复位（低电平有效）
    input         uart_rx,    // UART接收脚（接 单片机TX）
    output  [7:0] seg,        // 数码管段选
    output  [3:0] sel         // 数码管位选（静态显示，只开第1位）
);

// ===================== 1. 参数定义 =====================
parameter   BAUD_CNT = 50_000_000 / 115200;  // 115200波特率计数
reg         rx_done;                        // 接收完成标志(1拍有效)
reg   [7:0] rx_data;                        // 接收的8位ASCII数据
reg   [3:0] num;                            // 提取出的数字0-9

// ===================== 2. UART接收模块 =====================
// 功能：标准UART接收，输出rx_done(完成) + rx_data(ASCII码)
reg [15:0] cnt;
reg [ 3:0] bit_cnt;
reg [ 1:0] state;

localparam IDLE    = 2'd0;  // 空闲
localparam START   = 2'd1;  // 起始位
localparam RECV    = 2'd2;  // 接收数据
localparam STOP    = 2'd3;  // 停止位

always @(posedge clk or negedge rst_n) begin
    if(!rst_n) begin
        state   <= IDLE;
        cnt     <= 16'd0;
        bit_cnt <= 4'd0;
        rx_data <= 8'd0;
        rx_done <= 1'b0;
    end
    else case(state)
        IDLE: begin  // 等待起始位(低电平)
            rx_done <= 1'b0;
            if(uart_rx == 1'b0) state <= START;
        end

        START: begin  // 采样起始位
            if(cnt == BAUD_CNT/2) begin
                cnt <= 16'd0;
                state <= RECV;
            end
            else cnt <= cnt + 1'b1;
        end

        RECV: begin  // 接收8位数据
            if(cnt == BAUD_CNT) begin
                cnt <= 16'd0;
                rx_data[bit_cnt] <= uart_rx;
                bit_cnt <= bit_cnt + 1'b1;
                if(bit_cnt == 4'd7) state <= STOP;
            end
            else cnt <= cnt + 1'b1;
        end

        STOP: begin  // 接收停止位
            if(cnt == BAUD_CNT) begin
                cnt     <= 16'd0;
                bit_cnt <= 4'd0;
                rx_done <= 1'b1;       // 接收完成
                state   <= IDLE;
            end
            else cnt <= cnt + 1'b1;
        end
    endcase
end

// ===================== 3. ASCII 转 数字0-9 =====================
// 单片机发的是ASCII码：0→0x30  1→0x31 ... 9→0x39
always @(posedge clk or negedge rst_n) begin
    if(!rst_n)
        num <= 4'd0;
    else if(rx_done) begin  // 接收完成后判断
        if(rx_data >= 8'h30 && rx_data <= 8'h39)  // 判断是不是数字
            num <= rx_data[3:0];  // 提取低4位 = 真实数字
        // 非数字：保持上一次显示不变
    end
end

// ===================== 4. 数码管静态显示 =====================
// 共阴数码管段码 0~9
reg [7:0] seg_table[9:0];
initial begin
    seg_table[0] = 8'h3F; seg_table[1] = 8'h06; seg_table[2] = 8'h5B;
    seg_table[3] = 8'h4F; seg_table[4] = 8'h66; seg_table[5] = 8'h6D;
    seg_table[6] = 8'h7D; seg_table[7] = 8'h07; seg_table[8] = 8'h7F;
    seg_table[9] = 8'h6F;
end

assign seg = seg_table[num];  // 输出段码
assign sel = 4'b1110;         // 只点亮第1个数码管（静态显示）

endmodule